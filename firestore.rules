rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         'email' in request.auth.token &&
         request.auth.token.email != null) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    // 1. Pothole Pins Collection (RoadTok.in)
    match /pins/{pinId} {
      allow read: if true;
      
      // नागरिक बिना किसी अड़चन के तुरंत नया गड्ढा रिपोर्ट कर सकते हैं
      allow create: if request.resource.data.latitude is number &&
                       request.resource.data.longitude is number;

      // नागरिक +1 अपवोट और फोटो जोड़ सकते हैं, एडमिन मॉडरेट कर सकते हैं
      allow update: if true;

      // केवल एडमिन ही डिलीट कर सकते हैं (सुरक्षित)
      allow delete: if isAdmin();

      match /reporters/{userId} {
        allow read, write: if true;
      }
      match /votes/{userId} {
        allow read, write: if true;
      }
      match /flags/{userId} {
        allow read, write: if true;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // 2. Anti-Spam & Limits (RoadTok.in)
    match /limits/{uid} {
      allow read, write: if true;
    }
    match /ipLimits/{ipHash} {
      allow read, write: if true;
    }
    match /rate_limits/{docId} {
      allow read, write: if true;
    }

    // 3. Stats & Visitors (RoadTok.in)
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 4. Leaderboard (RoadTok.in)
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Admins Audit (RoadTok.in)
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 6. Save The Sahyadri Supporters Collection (savesahyadri.online)
    match /savesahyadri_supporters/{supporterId} {
      allow read: if true;
      allow create: if request.resource.data.displayName is string &&
                       request.resource.data.displayName.size() >= 2;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /sahyadri_supporters/{supporterId} {
      allow read: if true;
      allow create: if request.resource.data.displayName is string &&
                       request.resource.data.displayName.size() >= 2;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // 7. Default Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
